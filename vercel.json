{
  "version": 2,
  "rewrites": [
    {
      "source": "/project/:slug",
      "destination": "/api/og-fallback?slug=:slug"
    },
    {
      "source": "/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/og-image.jpeg",
      "destination": "/og-image.jpeg"
    },
    {
      "source": "/og-image.jpg",
      "destination": "/og-image.jpg"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
